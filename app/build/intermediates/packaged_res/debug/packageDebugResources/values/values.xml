<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string-array name="device_types">
        <item>ECO-GD</item>
    </string-array>
    <color name="accent_green">#2ECC71</color>
    <color name="accent_green_dark">#1E8449</color>
    <color name="accent_green_pressed">#27AE60</color>
    <color name="bg_elevated">#2A2A2A</color>
    <color name="bg_input">#242424</color>
    <color name="bg_primary">#121212</color>
    <color name="bg_secondary">#1E1E1E</color>
    <color name="border_default">#404040</color>
    <color name="btn_danger_bg">#3A2323</color>
    <color name="btn_danger_text">#E74C3C</color>
    <color name="btn_primary_bg">#2ECC71</color>
    <color name="btn_primary_text">#121212</color>
    <color name="btn_secondary_bg">#2A2A2A</color>
    <color name="btn_secondary_text">#F2F2F2</color>
    <color name="divider">#3A3A3A</color>
    <color name="gas_display_yellow">#FFDD00</color>
    <color name="ripple">#332ECC71</color>
    <color name="status_ok">#2ECC71</color>
    <color name="status_timeout">#E74C3C</color>
    <color name="status_wait">#A0A0A0</color>
    <color name="text_disabled">#6B6B6B</color>
    <color name="text_primary">#F2F2F2</color>
    <color name="text_secondary">#A0A0A0</color>
    <color name="transparent">#00000000</color>
    <color name="value_changed">#E74C3C</color>
    <string name="app_name">ECO-GD II mobile</string>
    <string name="tab_parameters">Параметры</string>
    <style name="Btn.Danger" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/btn_danger_text</item>
        <item name="android:textColor">@color/btn_danger_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="Btn.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="Btn.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/border_default</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="LabelSection">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextValue">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Theme.EcoGD" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryDark">@color/bg_elevated</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_elevated</item>
        <item name="android:navigationBarColor">@color/bg_elevated</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>